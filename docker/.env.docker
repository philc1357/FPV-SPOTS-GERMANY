# =============================================================
# Lokale App-Konfiguration – wird im Container über
# /var/www/html/.env gemountet (die echte .env bleibt unangetastet)
# =============================================================

# --- Datenbank (Servicename aus compose.yaml) ----------------
DB_HOST=db
DB_NAME=d046b4e2
DB_USER=d046b4e2
DB_PASS=fpvlocal

# --- SMTP: bewusst nur Platzhalter --------------------------
# Es läuft kein Mail-Container. Die Werte verhindern lediglich
# Fehler beim Laden von mailer.php / mailer_info.php.
# Betroffene Flows (Kontakt, Passwort-Reset, Vorschlags-Mails)
# schlagen lokal fehl – Registrierung und Login nicht.
SMTP_HOST=localhost
SMTP_PORT=465
SMTP_USER=dev@example.invalid
SMTP_PASS=dummy
SMTP_USER_INFO=dev@example.invalid
SMTP_PASS_INFO=dummy

# --- Web-Push (im Code aktuell ungenutzt) --------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@example.invalid
