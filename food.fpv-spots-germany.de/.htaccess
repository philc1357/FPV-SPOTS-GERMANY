# Security Headers
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' cdn.jsdelivr.net unpkg.com 'unsafe-inline'; style-src 'self' cdn.jsdelivr.net unpkg.com 'unsafe-inline'; img-src 'self' data: *.tile.openstreetmap.org; font-src 'self' cdn.jsdelivr.net; connect-src 'self'"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header always edit Set-Cookie ^(.*)$ $1;HttpOnly;Secure;SameSite=Lax
</IfModule>

# Session-Hardening (mod_php; bei PHP-FPM greift session_init.php)
<IfModule mod_php.c>
    php_flag  session.cookie_httponly  On
    php_flag  session.cookie_secure    On
    php_value session.cookie_samesite  Lax
    php_flag  session.use_strict_mode  On
    php_flag  session.use_only_cookies On
</IfModule>
<IfModule mod_php8.c>
    php_flag  session.cookie_httponly  On
    php_flag  session.cookie_secure    On
    php_value session.cookie_samesite  Lax
    php_flag  session.use_strict_mode  On
    php_flag  session.use_only_cookies On
</IfModule>

# Sensible Verzeichnisse vor Direktzugriff schützen
RewriteEngine On
RewriteRule ^private/ - [F,L]
RewriteRule ^plan/ - [F,L]

# HTTPS erzwingen
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Trailing-Space im Pfad entfernen
RewriteCond %{THE_REQUEST} ^[A-Z]+\s(.*?)(%20|\ )+(\?[^\s]*)?\sHTTP/ [NC]
RewriteRule ^ %1%3 [R=301,L,NE]

# /index.php aus URL entfernen
DirectoryIndex index.php
RewriteCond %{THE_REQUEST} /index\.php[\s?/] [NC]
RewriteRule ^index\.php$ / [L,R=301]

# /public/php/X.php → /X.php (301)
RewriteCond %{THE_REQUEST} /public/php/([a-zA-Z0-9_-]+\.php)[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]

# /public/html/errors/X.html → /X.html (301)
RewriteCond %{THE_REQUEST} /public/html/errors/([a-zA-Z0-9_-]+\.html)[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]

# Clean URLs: /dateiname.php → public/php/{bereich}/dateiname.php (intern)
RewriteCond %{REQUEST_URI} ^/([a-zA-Z0-9_-]+\.php)$ [NC]
RewriteCond %{DOCUMENT_ROOT}/public/php/map/%1 -f
RewriteRule ^([a-zA-Z0-9_-]+\.php)$ public/php/map/$1 [L,QSA]

RewriteCond %{REQUEST_URI} ^/([a-zA-Z0-9_-]+\.php)$ [NC]
RewriteCond %{DOCUMENT_ROOT}/public/php/auth/%1 -f
RewriteRule ^([a-zA-Z0-9_-]+\.php)$ public/php/auth/$1 [L,QSA]

RewriteCond %{REQUEST_URI} ^/([a-zA-Z0-9_-]+\.php)$ [NC]
RewriteCond %{DOCUMENT_ROOT}/public/php/legal/%1 -f
RewriteRule ^([a-zA-Z0-9_-]+\.php)$ public/php/legal/$1 [L,QSA]

# Clean URLs: /dateiname.html → public/html/errors/dateiname.html (intern)
RewriteCond %{REQUEST_URI} ^/([a-zA-Z0-9_-]+\.html)$ [NC]
RewriteCond %{DOCUMENT_ROOT}/public/html/errors/%1 -f
RewriteRule ^([a-zA-Z0-9_-]+\.html)$ public/html/errors/$1 [L,QSA]
