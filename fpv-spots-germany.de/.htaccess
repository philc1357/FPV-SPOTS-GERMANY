# Security Headers
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()"
    # Content-Security-Policy
    #
    # Alle Vendor-Libs (Bootstrap, Bootstrap Icons, Leaflet) liegen lokal
    # unter /public/vendor/ – script-src/style-src/font-src brauchen daher
    # keine CDN-Hosts mehr.
    #
    # connect-src gilt auch fuer fetch() INNERHALB des Service Workers.
    # sw.js cached die OSM-Tiles per tileStrategy() selbst und braucht den
    # Host deshalb hier; alle uebrigen Cross-Origin-Requests laesst sw.js
    # durch, sodass fuer sie img-src bzw. frame-src greift.
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: *.tile.openstreetmap.org server.arcgisonline.com img.youtube.com i.ytimg.com; font-src 'self'; connect-src 'self' https://*.tile.openstreetmap.org; frame-src https://www.youtube-nocookie.com"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header always edit Set-Cookie ^(.*)$ $1;HttpOnly;Secure;SameSite=Lax
</IfModule>

# Session-Hardening (wirkt bei mod_php, wird bei PHP-FPM ignoriert –
# dort greifen die Werte, die zusätzlich über session_init.php gesetzt werden)
<IfModule mod_php.c>
    php_flag  session.cookie_httponly  On
    php_flag  session.cookie_secure    On
    php_value session.cookie_samesite  Lax
    php_flag  session.use_strict_mode  On
    php_flag  session.use_only_cookies On
</IfModule>
<IfModule mod_php7.c>
    php_flag  session.cookie_httponly  On
    php_flag  session.cookie_secure    On
    php_value session.cookie_samesite  Lax
    php_flag  session.use_strict_mode  On
    php_flag  session.use_only_cookies On
</IfModule>
<IfModule mod_php8.c>
    php_flag  session.cookie_httponly  On
    php_flag  session.cookie_secure    On
    php_value session.cookie_samesite  Lax
    php_flag  session.use_strict_mode  On
    php_flag  session.use_only_cookies On
</IfModule>

# =============================================================
# Kompression
#
# Apaches mitgelieferte deflate.conf deckt zwar text/* und
# application/javascript ab, aber NICHT application/json – die
# JSON-APIs (/api/spots.php & Co.) gingen dadurch unkomprimiert
# raus. Die Liste hier steht bewusst im versionierten .htaccess
# statt in der Server-Config: so gilt sie auch bei einem Hoster,
# dessen globale Konfiguration wir nicht kennen.
# =============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript text/javascript
</IfModule>

# =============================================================
# Browser-Caching statischer Assets
#
# Ohne Freshness-Header revalidiert der Browser bei JEDER
# Navigation jedes Asset einzeln (18 Round-Trips fuer lauter
# 304er). mod_expires ist nicht ueberall geladen, deshalb setzen
# wir Cache-Control direkt ueber mod_headers.
#
# Bilder/Fonts sind inhaltlich unveraenderlich -> ein Jahr.
# Eigenes CSS/JS bekommt eine Woche; die Invalidierung laeuft
# ueber den ?v=-Parameter aus private/php/core/assets.php.
#
# WICHTIG: Der sw.js-Block weiter unten muss NACH diesem Block
# stehen – er ueberschreibt das max-age fuer den Service Worker
# wieder mit no-store. Reihenfolge hier nicht vertauschen.
# =============================================================
<IfModule mod_headers.c>
    <FilesMatch "\.(woff2?|ttf|eot|ico|png|jpe?g|webp|svg|gif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# Service Worker: kein Cache, damit Updates sofort greifen
<IfModule mod_headers.c>
    <Files "sw.js">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Service-Worker-Allowed "/"
    </Files>
</IfModule>

# HTTPS erzwingen (aktivieren sobald SSL-Zertifikat eingerichtet ist)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteEngine On

# Leerzeichen am Ende des URL-Pfads entfernen (literal und %20-kodiert)
RewriteCond %{THE_REQUEST} ^[A-Z]+\s(.*?)(%20|\ )+(\?[^\s]*)?\sHTTP/ [NC]
RewriteRule ^ %1%3 [R=301,L,NE]

# /index.php aus URL entfernen
DirectoryIndex index.php
RewriteCond %{THE_REQUEST} /index\.php[\s?/] [NC]
RewriteRule ^index\.php$ / [L,R=301]

# /public/php/api/X.php → /api/X.php umleiten (301)
# Muss VOR der allgemeinen Regel stehen: dort steckt der Unterordner in einer
# non-capturing group und ginge verloren (→ /X.php statt /api/X.php).
RewriteCond %{THE_REQUEST} /public/php/api/([a-zA-Z0-9_-]+\.php)[\s?] [NC]
RewriteRule ^ /api/%1 [L,R=301]

# /public/php/X.php (auch in Unterordnern) → /X.php umleiten (301)
RewriteCond %{THE_REQUEST} /public/php/(?:[a-zA-Z0-9_-]+/)?([a-zA-Z0-9_-]+\.php)[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]

# /public/html/errors/X.html → /X.html umleiten (301)
RewriteCond %{THE_REQUEST} /public/html/errors/([a-zA-Z0-9_-]+\.html)[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]

# Clean URLs: /dateiname.php → public/php/[unterordner]/dateiname.php (intern)
RewriteCond %{REQUEST_URI} ^/([a-zA-Z0-9_-]+\.php)$ [NC]
RewriteCond %{DOCUMENT_ROOT}/public/php/auth/%1 -f
RewriteRule ^([a-zA-Z0-9_-]+\.php)$ public/php/auth/$1 [L,QSA]

RewriteCond %{REQUEST_URI} ^/([a-zA-Z0-9_-]+\.php)$ [NC]
RewriteCond %{DOCUMENT_ROOT}/public/php/account/%1 -f
RewriteRule ^([a-zA-Z0-9_-]+\.php)$ public/php/account/$1 [L,QSA]

RewriteCond %{REQUEST_URI} ^/([a-zA-Z0-9_-]+\.php)$ [NC]
RewriteCond %{DOCUMENT_ROOT}/public/php/spots/%1 -f
RewriteRule ^([a-zA-Z0-9_-]+\.php)$ public/php/spots/$1 [L,QSA]

RewriteCond %{REQUEST_URI} ^/([a-zA-Z0-9_-]+\.php)$ [NC]
RewriteCond %{DOCUMENT_ROOT}/public/php/community/%1 -f
RewriteRule ^([a-zA-Z0-9_-]+\.php)$ public/php/community/$1 [L,QSA]

RewriteCond %{REQUEST_URI} ^/([a-zA-Z0-9_-]+\.php)$ [NC]
RewriteCond %{DOCUMENT_ROOT}/public/php/contact/%1 -f
RewriteRule ^([a-zA-Z0-9_-]+\.php)$ public/php/contact/$1 [L,QSA]

RewriteCond %{REQUEST_URI} ^/([a-zA-Z0-9_-]+\.php)$ [NC]
RewriteCond %{DOCUMENT_ROOT}/public/php/legal/%1 -f
RewriteRule ^([a-zA-Z0-9_-]+\.php)$ public/php/legal/$1 [L,QSA]

# Clean URL: /api/X.php → public/php/api/X.php (intern)
# Sonderfall gegenüber den Regeln oben: bei der API ist der Ordnername Teil der
# öffentlichen URL, damit /api/spots.php nicht mit /spots.php kollidiert.
# Das -f-Guard und die enge Zeichenklasse verhindern Path-Traversal,
# [QSA] erhält die Query-Parameter (?id=, ?user_id=, ?action=).
RewriteCond %{DOCUMENT_ROOT}/public/php/api/$1 -f
RewriteRule ^api/([a-zA-Z0-9_-]+\.php)$ public/php/api/$1 [L,QSA]

# Clean URLs: /dateiname.html → public/html/errors/dateiname.html (intern)
RewriteCond %{REQUEST_URI} ^/([a-zA-Z0-9_-]+\.html)$ [NC]
RewriteCond %{DOCUMENT_ROOT}/public/html/errors/%1 -f
RewriteRule ^([a-zA-Z0-9_-]+\.html)$ public/html/errors/$1 [L,QSA]
